#!/bin/sh
# Compatibility shim for shortcuts created by Scribiva builds that used the
# Python core (`scribiva-cli toggle`). The Rust app repairs such shortcuts the
# next time it starts; until then this forwards the common actions to it.
case "${1:-}" in
  toggle) exec /usr/bin/scribiva --toggle ;;
  cancel) exec /usr/bin/scribiva --cancel ;;
  *) echo "scribiva-cli is replaced by the Scribiva app (/usr/bin/scribiva)." >&2; exit 2 ;;
esac
