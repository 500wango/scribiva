[Unit]
Description=Scribiva API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=scribiva
Group=scribiva
EnvironmentFile=/etc/scribiva/scribiva.env
Environment=PYTHONPATH=/opt/scribiva/server
Environment=PYTHONUNBUFFERED=1
ExecStartPre=/opt/scribiva/venv/bin/python -m scribiva_server init-db
ExecStart=/opt/scribiva/venv/bin/python -m scribiva_server serve
Restart=on-failure
RestartSec=3
UMask=0077
StateDirectory=scribiva
StateDirectoryMode=0700
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
ReadWritePaths=/var/lib/scribiva

[Install]
WantedBy=multi-user.target
