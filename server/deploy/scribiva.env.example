# /etc/scribiva/scribiva.env  (root:scribiva, mode 0640). Never commit real values.
SCRIBIVA_DB=/var/lib/scribiva/scribiva.sqlite3
SCRIBIVA_HOST=127.0.0.1
SCRIBIVA_PORT=8787
SCRIBIVA_ALLOW_REMOTE=0
SCRIBIVA_PUBLIC_BASE_URL=https://api.example.com

GROQ_API_KEY=
SCRIBIVA_ASR_MODEL=whisper-large-v3-turbo
SCRIBIVA_GRAMMAR_MODEL=openai/gpt-oss-20b

# Monthly free tier and Pro (seconds per UTC calendar month). Pending pricing decision D-004.
SCRIBIVA_FREE_SECONDS=1800
SCRIBIVA_PRO_SECONDS=36000
SCRIBIVA_GRACE_SECONDS=180

# Stripe (existing account). Use test keys on staging.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_MONTHLY=
STRIPE_PRICE_ID_ANNUAL=

# Magic-link email (FR-019)
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Scribiva <no-reply@example.com>
